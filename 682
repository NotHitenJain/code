class Solution {
public:
    int calPoints(vector<string>& op) {
        stack<int> st;
        int ans=0;
        for(int i=0;i<op.size();i++){
            if(op[i] =="D"){
                ans+= 2*st.top();
                st.push(2*st.top());
            }
            else if(op[i]=="C"){
                ans -= st.top();
                st.pop();
            }
            else if(op[i]=="+"){
               int top = st.top();
               st.pop();
               int newtop = top + st.top();
               st.push(top);
               st.push(newtop);
               ans += newtop;
            }
            else {
                ans += stoi(op[i]);
                st.push(stoi(op[i]));
            }
        }
   return ans; }
};
